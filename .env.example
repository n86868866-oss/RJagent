# 应用配置
APP_NAME=Research Journey Agent
APP_VERSION=0.1.0
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
APP_SECRET_KEY=replace-with-a-long-random-value
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000


# 数据目录
DATA_DIR=./data
RAW_PDF_DIR=./data/raw
PARSED_DOCUMENT_DIR=./data/parsed
DOCUMENT_ASSET_DIR=./data/assets
SQLITE_PATH=./data/app.db
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_ENABLE_WAL=true

# LLM：OpenAI 兼容接口
LLM_PROVIDER=openai_compatible
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=your-api-base-url
LLM_MODEL=your-model-name
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1

# -------------------------
# MinerU/PyMuPDF 精准解析 API
# -------------------------
PDF_PARSER_PRIMARY=mineru
PDF_PARSER_FALLBACK=pymupdf

# MinerU 模式选择：local_service | cloud_api
MINERU_MODE=local_service
MINERU_BASE_URL=http://127.0.0.1:8001
MINERU_BACKEND=hybrid-engine
# 云接口模式当前不用
#MINERU_API_BASE=https://mineru.net/api/v4
#MINERU_API_TOKEN=
MINERU_TIMEOUT_SECONDS=900
MINERU_POLL_INTERVAL_SECONDS=2
MINERU_MAX_CONCURRENCY=1
MINERU_OUTPUT_FORMAT=json

PYMUPDF_VALIDATE_PDF=true
PYMUPDF_ENABLE_TEXT_FALLBACK=true
PYMUPDF_RENDER_DPI=150

# -------------------------
#Embedding 向量嵌入
# -------------------------
# Text Embedding：本地 Hugging Face TEI 服务 local_tei
TEXT_EMBEDDING_PROVIDER=local_tei
TEXT_EMBEDDING_API_KEY=
# local_tei 只填写服务根地址，程序会自动请求 /embed
TEXT_EMBEDDING_BASE_URL=http://127.0.0.1:8080
TEXT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
TEXT_EMBEDDING_DIMENSION=1024
TEXT_EMBEDDING_BATCH_SIZE=10
TEXT_EMBEDDING_TIMEOUT_SECONDS=120
TEXT_EMBEDDING_MAX_RETRIES=2
TEXT_EMBEDDING_QUERY_INPUT_TYPE=query
TEXT_EMBEDDING_DOCUMENT_INPUT_TYPE=document
TEXT_EMBEDDING_OUTPUT_TYPE=dense

# Visual Embedding：OpenAI 兼容接口
VISUAL_EMBEDDING_ENABLED=false
VISUAL_EMBEDDING_PROVIDER=bge_visualized_service
VISUAL_EMBEDDING_BASE_URL=http://127.0.0.1:8002
VISUAL_EMBEDDING_API_KEY=
VISUAL_EMBEDDING_MODEL=BAAI/bge-visualized-m3
VISUAL_EMBEDDING_DIMENSION=1024
VISUAL_EMBEDDING_BATCH_SIZE=4
VISUAL_EMBEDDING_TIMEOUT_SECONDS=180

BGE_VISUALIZED_TEXT_MODEL=BAAI/bge-m3
BGE_VISUALIZED_WEIGHT_PATH=/models/Visualized_m3.pth
BGE_VISUALIZED_DEVICE=cuda
BGE_VISUALIZED_ALLOW_REMOTE_CODE=false

# -------------------------
# Reranker 重排序
# -------------------------
RERANKER_BASE_URL=http://127.0.0.1:8081
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TIMEOUT_SECONDS=60
RERANKER_MAX_RETRIES=2

RETRIEVER_CANDIDATE_TOP_K=20
RETRIEVER_FINAL_TOP_K=5
# -------------------------
#RAG 配置
# -------------------------
# Ingestion and chunking
MAX_UPLOAD_MB=50
RETRIEVAL_TOP_K=6
CHUNK_SIZE_CHARS=1800
CHUNK_OVERLAP_CHARS=250
MIN_CHUNK_CHARS=120
INGESTION_MAX_CONCURRENCY=1

# Retrieval and chat-agent harness
RETRIEVAL_CANDIDATE_TOP_K=20
RETRIEVAL_FINAL_TOP_K=5
FIGURE_RETRIEVAL_TOP_K=5
MAX_RETRIEVAL_ATTEMPTS=2
MAX_AGENT_STEPS=4

CHAT_RECENT_MESSAGES=6
CHAT_SUMMARY_TRIGGER_MESSAGES=12
QUERY_REWRITE_MESSAGES=4
MAX_HISTORY_CHARS=8000

REQUIRE_CITATIONS=true
REFUSE_WITHOUT_EVIDENCE=true
ALLOW_REMOTE_MODEL_CODE=false

# -------------------------
# Qdrant 数据库
# -------------------------
VECTOR_STORE_BACKEND=qdrant

# Qdrant 模式选择：local | server
QDRANT_MODE=local
QDRANT_PATH=./data/qdrant   
# Server mode 
QDRANT_URL=http://127.0.0.1:6333
# Server mode 云API
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=30
QDRANT_PREFER_GRPC=false
QDRANT_CHECK_COMPATIBILITY=true

QDRANT_TEXT_COLLECTION=paper_text__qwen3_embedding_0_6b__1024__v1
QDRANT_FIGURE_COLLECTION=paper_figures__bge_visualized_m3__1024__v1

QDRANT_DISTANCE=cosine
QDRANT_RECREATE_COLLECTIONS=false
INDEX_VERSION=v1

# 当前前端由 FastAPI 同源提供，不需要 CORS。
# 后续若改为 Vue/Vite 独立运行，再启用：
# CORS_ORIGINS=http://localhost:5173
